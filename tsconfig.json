{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@fixtures/*": [
        "./src/framework/fixtures/*"
      ]
    },
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}